ign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="1300" y="485" width="270" height="27.3" as="geometry" /></mxCell><mxCell id="t22" value="Q1  Daily traffic" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=27.00000;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="55" y="665" width="470" height="35.1" as="geometry" /></mxCell><mxCell id="t23" value="Group by date + status.&lt;br&gt;Count requests and sum bytes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="55" y="710" width="470" height="62.400000000000006" as="geometry" /></mxCell><mxCell id="t24" value="Q2  Top 20 resources" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=27.00000;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="565" y="665" width="470" height="35.1" as="geometry" /></mxCell><mxCell id="t25" value="Count requests and sum bytes.&lt;br&gt;Count exact distinct hosts per resource.&lt;br&gt;Sort by count DESC, then resource ASC.&lt;br&gt;Keep the global top 20." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="565" y="710" width="470" height="124.80000000000001" as="geometry" /></mxCell><mxCell id="t26" value="Q3  Hourly errors" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=27.00000;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="1075" y="665" width="470" height="35.1" as="geometry" /></mxCell><mxCell id="t27" value="Group by date + hour.&lt;br&gt;Errors: status 400-599.&lt;br&gt;error_rate = errors / all valid requests.&lt;br&gt;Count distinct hosts making errors.&lt;br&gt;Keep zero-error hours with traffic." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="1075" y="710" width="470" height="156.0" as="geometry" /></mxCell><mxCell id="t28" value="Final results use all valid batches. A host repeated across batches counts once per group." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="55" y="930" width="1490" height="31.200000000000003" as="geometry" /></mxCell><mxCell id="t29" value="Choose the final top 20 only after complete resource totals are available." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="55" y="974" width="1490" height="31.200000000000003" as="geometry" /></mxCell><mxCell id="t30" value="Compare with MongoDB: same raw files, batch size and parsing; compare query values only." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24.00000;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;lineHeight=130;" vertex="1" connectable="0" parent="1"><mxGeometry x="55" y="1018" width="1490" height="31.200000000000003" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>